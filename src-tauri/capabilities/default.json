{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for Cablebag's own page only: web pages in browser tabs get nothing",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$TEMP/**"
        }
      ]
    },
    "dialog:default",
    "core:window:allow-destroy",
    "core:webview:allow-set-webview-zoom"
  ]
}